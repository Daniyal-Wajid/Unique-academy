# Supabase (cloud project)
NEXT_PUBLIC_SUPABASE_URL= "https://tttcaobfjskqkuxoshla.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_NAME=Unique Academy
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated hostnames/IPs allowed to open the Next.js dev server over LAN
ALLOWED_DEV_ORIGINS=192.168.1.10

# ZKTeco MB460 — used by device-service/ (Phase 3)
# Do not expose port 4370 to the public internet.
ZKTECO_IP=
ZKTECO_PORT=4370
ZKTECO_PASSWORD=
ZKTECO_TIMEOUT=10
ZKTECO_DEVICE_SERIAL=AF6P210960179

# SMS Gateway — Android phone running "SMS Gateway" app
# The phone must be on the same WiFi network OR have a public URL.
# Format: http://<phone-ip>:<port>  (default port is usually 8080)
SMS_GATEWAY_URL=http://192.168.100.21:8080
# Some gateway apps require a device ID or auth token:
SMS_GATEWAY_DEVICE_ID=
SMS_GATEWAY_AUTH_TOKEN=
# Set to 'true' to enable real SMS sending. When 'false', SMS are only logged.
SMS_GATEWAY_ENABLED=true
